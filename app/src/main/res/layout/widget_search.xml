<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_search_tint" android:contentDescription="@null" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
        android:text="@string/app_name" android:textColor="@color/text2" android:textSize="16sp" />
</LinearLayout>
